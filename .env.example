# PostgreSQL
POSTGRES_DB=TestApi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# строка подключения к БД (api)
CONNECTION_STRING=Host=db;Port=5432;Database=TestApi;Username=postgres;Password=change_me

# настройки RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=task.events
RABBITMQ_ROUTING_KEY=task.completed
RABBITMQ_QUEUE_NAME=task.completed.queue
